# ── GoVisa Portal — variáveis de ambiente ──
# Copie este arquivo para `.env.local` e ajuste os valores.

# Segredo para assinar as sessões (JWT). Troque por uma string longa e aleatória.
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-de-32+caracteres

# SMTP para envio de e-mails ao cliente.
# Em desenvolvimento, deixe SMTP_HOST vazio: os e-mails são impressos no console
# (nenhum e-mail é enviado de verdade).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Go Visa Law Firm <contato@govisalaw.com>"
